{
 "programs": [
  {
   "key": "fib",
   "title": "Function calls",
   "about": "The slow recursive Fibonacci of a number: millions of calls and additions."
  },
  {
   "key": "loop",
   "title": "A tight loop",
   "about": "Whole-number arithmetic in a while loop, a billion times round."
  },
  {
   "key": "sort",
   "title": "Sorting a list",
   "about": "A quicksort written in the program, over ten million made-up numbers."
  },
  {
   "key": "strings",
   "title": "Building text",
   "about": "Ten million numbers turned to text, joined, then read a character at a time."
  },
  {
   "key": "trees",
   "title": "Many small objects",
   "about": "The binary-trees test: make and drop millions of small trees."
  },
  {
   "key": "nbody",
   "title": "Floating point",
   "about": "Five planets moved ten million small steps, as in the benchmarks game."
  }
 ],
 "engines": {
  "c": {
   "label": "C",
   "about": "cc -O2. The line every other bar is measured against.",
   "tone": "e-c"
  },
  "rust": {
   "label": "Rust",
   "about": "rustc -C opt-level=3.",
   "tone": "e-rust"
  },
  "python": {
   "label": "Python 3",
   "about": "CPython, the usual python3.",
   "tone": "e-py"
  },
  "zeno": {
   "label": "Zeno",
   "about": "zeno build: C, with the garbage collector and every overflow check.",
   "tone": "e-z1"
  },
  "zeno-llvm": {
   "label": "Zeno LLVM",
   "about": "zeno build --llvm: the same program through LLVM instead of C.",
   "tone": "e-zl"
  },
  "zeno-release": {
   "label": "Zeno release",
   "about": "zeno build --release: no overflow checks, as in Rust's release builds.",
   "tone": "e-z2"
  },
  "zeno-owned": {
   "label": "Zeno owned",
   "about": "zeno build --release --owned: one owner for each value and no collector.",
   "tone": "e-z3"
  },
  "zeno-owned-checked": {
   "label": "Zeno owned, checked",
   "about": "zeno build --owned: one owner, overflow checks kept.",
   "tone": "e-z2"
  },
  "zeno-nc": {
   "label": "Zeno, no collector",
   "about": "The old build for a chip, with one fixed pool.",
   "tone": "e-z2"
  },
  "vm": {
   "label": "zeno run --vm",
   "about": "The bytecode virtual machine.",
   "tone": "e-vm"
  },
  "run": {
   "label": "zeno run",
   "about": "The interpreter that walks the syntax tree.",
   "tone": "e-run"
  }
 },
