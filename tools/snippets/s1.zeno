let readings = [21.5, 22.0, -99.0, 21.0, 150.0]
class Sensor {
    low: float
    high: float

    function average(self, readings: list[float]) -> float {
        var total: float = 0.0
        var count: int = 0
        for reading in readings {
            if self.low <= reading <= self.high {
                total += reading
                count += 1
            }
        }
        return total / count
    }
}

print(Sensor(-40.0, 85.0).average(readings))
